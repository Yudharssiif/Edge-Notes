{
  "name": "edge-notes-widget",
  "version": "1.0.0",
  "description": "Desktop Edge-Snapping Auto-Hide Notes & To-Do Widget",
  "main": "electron.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.edgenotes.app",
    "productName": "EdgeNotes",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.cjs"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "keywords": [
    "electron",
    "react",
    "sticky-notes",
    "todo",
    "edge-snapping",
    "auto-hide"
  ],
  "author": "GeoNovex",
  "license": "MIT",
  "dependencies": {
    "auto-launch": "^5.0.6",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
